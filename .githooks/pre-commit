#!/bin/bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Optional local convenience. Required CI checks remain the enforcement boundary.
# Scan what is being committed, which can differ from the working tree, then the usual hygiene lane.
mise exec -- gitleaks git --pre-commit --staged --redact --no-banner --config .gitleaks.toml
mise exec -- scripts/check.sh hygiene
