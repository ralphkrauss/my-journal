{
  "cases" : [
    {
      "expect" : "accept",
      "file" : "database/foreign.sqlite",
      "name" : "foreign",
      "note" : "An empty library written by Python's sqlite3 in its own style: quoted identifiers, lower-case types, table constraints, NOT NULL on the primary keys."
    },
    {
      "expect" : "accept",
      "file" : "database/foreign-older.sqlite",
      "name" : "foreign-older",
      "note" : "Only v1, sync-reconciliation and history-record-index are recorded and created: a reader applies the other two migrations."
    },
    {
      "expect" : "damaged",
      "file" : "database/foreign-trigger.sqlite",
      "name" : "foreign-trigger",
      "note" : "A trigger the migrations do not create."
    },
    {
      "expect" : "damaged",
      "file" : "database/foreign-view.sqlite",
      "name" : "foreign-view",
      "note" : "A view the migrations do not create."
    },
    {
      "expect" : "damaged",
      "file" : "database/foreign-extra-table.sqlite",
      "name" : "foreign-extra-table",
      "note" : "A table the migrations do not create."
    },
    {
      "expect" : "damaged",
      "file" : "database/foreign-missing-column.sqlite",
      "name" : "foreign-missing-column",
      "note" : "records has no dirty column."
    },
    {
      "expect" : "damaged",
      "file" : "database/foreign-nullable-column.sqlite",
      "name" : "foreign-nullable-column",
      "note" : "records.kind may be NULL."
    },
    {
      "expect" : "newer",
      "file" : "database/foreign-unknown-migration.sqlite",
      "name" : "foreign-unknown-migration",
      "note" : "grdb_migrations lists a migration this version does not know: written by a newer version."
    },
    {
      "expect" : "damaged",
      "file" : "database/foreign-migration-objects-missing.sqlite",
      "name" : "foreign-migration-objects-missing",
      "note" : "server-versions is recorded but its table was never created."
    },
    {
      "expect" : "damaged",
      "file" : "database/foreign-migrations-out-of-order.sqlite",
      "name" : "foreign-migrations-out-of-order",
      "note" : "history-checkpoints is recorded without the migrations before it."
    },
    {
      "expect" : "damaged",
      "file" : "database/foreign-wal.sqlite",
      "name" : "foreign-wal",
      "note" : "File format versions 2 and 2 (write-ahead logging): not a one-file snapshot."
    }
  ],
