    {
      "name": "two-devices-typing-in-one-entry-for-twenty-rounds",
      "note": "Each device writes, pauses and synchronizes in turn. Each device keeps one copy of the other and replaces it with the other's later version as long as nobody touched it, so there are two copies in all, not one per exchange. The last text written by each device exists, and the entry is the last one that reached the server.",
      "devices": ["A", "B"],
      "steps": [
        {"device": "A", "do": "createJournal", "record": "home", "title": "Home"},
        {"device": "A", "do": "createEntry", "record": "page", "journal": "home", "title": "Page", "text": "t"},
        {"device": "A", "do": "sync"},
        {"device": "B", "do": "sync"},
        {"do": "repeat", "times": 20, "steps": [
          {"device": "A", "do": "editEntry", "record": "page", "text": "a{n}"},
          {"device": "A", "do": "sync"},
          {"device": "B", "do": "editEntry", "record": "page", "text": "b{n}"},
          {"device": "B", "do": "sync"}
        ]},
        {"do": "settleAll"}
      ],
      "expect": {
        "total": 4,
        "records": [
          {"record": "page", "kind": "entry", "title": "Page", "text": "b20", "state": "live"},
          {"kind": "entry", "title": "Page (other version)", "text": "a20", "state": "live"},
          {"kind": "entry", "title": "Page (other version)", "text": "b19", "state": "live"}
        ],
        "notes": {"A": ["keptBoth"], "B": ["keptBoth"]},
        "reviewRows": 0
      }
    },
    {
      "name": "server-restored-to-a-backup-and-three-devices-reconnect",
      "note": "A, B and C hold a version the restored server lost; D wrote another one on the restored server. Whichever devices reconcile first, every device ends with both texts once: the other version is kept as one separate entry, not one per device.",
      "devices": ["A", "B", "C", "D"],
      "steps": [
        {"device": "A", "do": "createJournal", "record": "home", "title": "Home"},
        {"device": "A", "do": "createEntry", "record": "page", "journal": "home", "title": "Page", "text": "t"},
        {"device": "A", "do": "sync"},
        {"device": "B", "do": "sync"},
        {"device": "C", "do": "sync"},
        {"device": "D", "do": "sync"},
        {"do": "backupServer", "label": "before"},
        {"device": "A", "do": "editEntry", "record": "page", "text": "a"},
        {"device": "A", "do": "sync"},
        {"device": "B", "do": "sync"},
        {"device": "C", "do": "sync"},
        {"do": "restoreServer", "label": "before"},
        {"device": "D", "do": "editEntry", "record": "page", "text": "d"},
        {"device": "D", "do": "sync"},
        {"device": "A", "do": "sync"},
        {"device": "B", "do": "sync"},
        {"device": "C", "do": "sync"},
        {"do": "settleAll"}
      ],
      "expect": {
        "total": 3,
        "records": [
          {"record": "page", "kind": "entry", "title": "Page", "text": "a", "state": "live"},
          {"kind": "entry", "title": "Page (other version)", "text": "d", "state": "live"}
        ],
        "notes": {"A": ["keptBoth"]},
        "reviewRows": 0
      }
    }
