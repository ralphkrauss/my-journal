    {
      "name": "several-versions-of-an-entry-arrive-while-another-is-unsent",
      "note": "A writes three versions while B is offline with one edit of its own: B keeps one copy, of the latest version it meets, and the earlier ones are not copied.",
      "devices": ["A", "B"],
      "steps": [
        {"device": "A", "do": "createJournal", "record": "home", "title": "Home"},
