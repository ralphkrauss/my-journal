          {"kind": "entry", "title": "Notes", "text": "words written on A", "state": "unavailable"}
        ],
        "notes": {"A": ["deletedAndChanged", "journalDeleted"]},
        "reviewRows": 0
      }
    },
    {
      "name": "entry-edited-on-three-devices-a-then-b-then-c",
      "note": "The version that reached the server last is the entry; each device that overwrote a version it had not seen keeps it as a separate entry. Every text exists once, on every device.",
      "devices": ["A", "B", "C"],
      "steps": [
        {"device": "A", "do": "createJournal", "record": "home", "title": "Home"},
        {"device": "A", "do": "createEntry", "record": "page", "journal": "home", "title": "Page", "text": "t"},
        {"device": "A", "do": "sync"},
        {"device": "B", "do": "sync"},
        {"device": "C", "do": "sync"},
        {"device": "A", "do": "editEntry", "record": "page", "text": "a"},
        {"device": "B", "do": "editEntry", "record": "page", "text": "b"},
        {"device": "C", "do": "editEntry", "record": "page", "text": "c"},
        {"device": "A", "do": "sync"},
        {"device": "B", "do": "sync"},
        {"device": "C", "do": "sync"},
        {"do": "settleAll"}
      ],
      "expect": {
        "total": 4,
        "records": [
          {"record": "page", "kind": "entry", "title": "Page", "text": "c", "state": "live"},
          {"kind": "entry", "title": "Page (other version)", "text": "a", "state": "live"},
          {"kind": "entry", "title": "Page (other version)", "text": "b", "state": "live"}
        ],
        "notes": {"B": ["keptBoth"], "C": ["keptBoth"]},
        "reviewRows": 0
      }
    },
