{
  "corpusVersion": 1,
  "purpose": "A conversation with the server's sync endpoints (protocol/README.md, Sync and conflicts): requests and the exact responses. The server's tests replay it against a new server; clients' tests read each response with their own decoders. See README.md in this folder.",
  "preconditions": "A server whose vault is set up in recovery format 1 or 2 (encrypted), with one device that sends its bearer credential on every request unless a step says otherwise. Steps run in order on the same server.",
  "matching": {
    "exact": "Every member of the response body equals the fixture's, and the response has no other members.",
    "subset": "Every member and value in the fixture is in the response; arrays must contain each listed element; the response may have more.",
    "volatile": "JSON pointers to values the server chooses (a UUID or an ISO 8601 timestamp). They are compared by format, not by value.",
    "identicalTo": "The response body equals the actual body of the named earlier step, volatile values included."
  },
  "steps": [
