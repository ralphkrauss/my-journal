            "sync-continuity",
            "sync-continuity-digest",
            "private-envelope",
            "pairing-invite",
            "setup-check",
            "encryption-upgrade",
            "agent-access-2",
            "sync-short-receipt",
            "sync-wait"
          ]
        },
        "expect": 0,
        "note": "It cannot lock a client out of a server whose list is complete, or let one skip the check."
      },
