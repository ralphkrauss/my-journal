          "initialized": true,
          "features": [
            "record-kinds",
            "sync-wait",
            "sync-short-receipt",
            "agent-access-2",
            "encryption-upgrade",
            "setup-check",
            "pairing-invite",
            "private-envelope",
            "sync-continuity-digest",
            "sync-continuity",
            "password-change",
            "pairing-check-code",
            "sync-identity"
          ]
        },
        "expect": 1
      },
      {
        "name": "malformed-string-with-all-13",
        "status": {
          "protocolVersion": 1,
          "initialized": true,
          "protocolRevision": "x",
